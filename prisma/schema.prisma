
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole @default(BUYER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tickets      Ticket[]
  orders       Order[]
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  category    TicketCategory
  description String?
  from        String
  to          String
  travelDate  DateTime
  travelTime  String?
  seatNumber  String?
  ticketType  String?
  price       Float
  quantity    Int            @default(1)
  status      TicketStatus   @default(AVAILABLE)

  sellerId    String
  seller      User           @relation(fields: [sellerId], references: [id])

  orders      Order[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerId])
}

model Order {
  id            String      @id @default(cuid())

  buyerId       String
  ticketId      String

  quantity      Int
  totalAmount   Float

  status        OrderStatus @default(PENDING)
  paymentMethod String?

  buyer         User        @relation(fields: [buyerId], references: [id])
  ticket        Ticket      @relation(fields: [ticketId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([buyerId])
  @@index([ticketId])
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum TicketCategory {
  BUS
  TRAIN
  FLIGHT
  EVENT
  MOVIE
  OTHER
}

enum TicketStatus {
  AVAILABLE
  SOLD
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

