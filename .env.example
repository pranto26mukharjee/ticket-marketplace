# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/ticketlagbe"

# Long random secret (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Claude API key used to read and verify uploaded ticket PDFs.
# Without it, every new listing goes to the manual admin review queue.
ANTHROPIC_API_KEY=""

# HMAC secret shared with your payment provider for /api/payments/webhook
PAYMENT_SECRET_KEY=""

# "true" only for local demos: enables the simulated card flow and unsigned webhooks.
PAYMENT_SANDBOX="false"
NEXT_PUBLIC_PAYMENT_SANDBOX="false"

# Merchant wallets buyers send money to (shown at checkout)
NEXT_PUBLIC_BKASH_NUMBER="01XXXXXXXXX"
NEXT_PUBLIC_BKASH_TYPE="Merchant"
NEXT_PUBLIC_NAGAD_NUMBER="01XXXXXXXXX"
NEXT_PUBLIC_NAGAD_TYPE="Merchant"
NEXT_PUBLIC_ROCKET_NUMBER="01XXXXXXXXX"
NEXT_PUBLIC_ROCKET_TYPE="Merchant"
